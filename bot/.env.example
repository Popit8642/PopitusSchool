# Telegram
BOT_TOKEN=your_telegram_bot_token
PROXY_URL=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=popit
DB_PASS=your_db_password
DB_NAME=PopitusSchool

# Redis / arq
REDIS_URL=redis://localhost:6379

# Ollama: LLM
LLM_BASE_URL=http://localhost:11434
LLM_MODEL_CHAT=qwen2.5:3b-instruct-q4_K_M
LLM_TIMEOUT_SECONDS=240
LLM_MAX_TOKENS=3000
LLM_MAX_RETRIES=0
LLM_MAX_CONCURRENCY=1

# Ollama: эмбеддинги
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=16

# RAG
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.7

# Загрузка PDF
MAX_PDF_SIZE_MB=20
MIN_PDF_SIZE_KB=10
OCR_LANG=rus+eng
UPLOAD_DIR=data/uploads
INGEST_JOB_TIMEOUT_SECONDS=3600

# Модерация содержимого
MODERATION_MODEL=qwen2.5:3b-instruct-q4_K_M
MODERATION_TIMEOUT_SECONDS=60
MODERATION_MAX_CHARS=2000

# Тесты и репетитор (Redis)
QUIZ_CONTEXT_TTL_SECONDS=3600
TUTOR_CONTEXT_TTL_SECONDS=21600

# Админка
# ID пользователей через запятую, которым нужно выдать флаг is_admin
ADMIN_IDS=
BROADCAST_COOLDOWN_SECONDS=60
BROADCAST_DELAY_SECONDS=0.05

# Подписка Pro (Telegram Stars)
PRO_PRICE_STARS=100

# Логирование
LOG_LEVEL=INFO
